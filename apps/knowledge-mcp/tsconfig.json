{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-tsc",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "dist-tsc",
    "node_modules",
    "src/**/*.test.ts",
    "tests/**/*"
  ]
}
