# Knowledge E3 — self-host environment. Copy to `.env` (gitignored) and edit.
# Consumed by docker-compose.yml. Everything has a working default except
# SEED_ADMIN_PASSWORD, which you should set before the first boot.
#
# Precedence: built-in defaults -> knowledge-e3.config.yaml -> these env vars.
# Placeholders only — never commit a real secret here.
# See docs/self-hosting.md for the full walk-through.

# --- First-run admin --------------------------------------------------------
# The container entrypoint idempotently creates this admin on boot (admin only,
# no demo data) and is a no-op once it exists. Leave the password unset and no
# admin is created — the instance then has a login wall and nothing behind it.
# Authentication cannot be turned off, so set this.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@local
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Networking / access ----------------------------------------------------
# Host interface and port the container is published on (it always listens on
# 3000 inside). The default keeps it on loopback; put 0.0.0.0 here only when
# something else terminates TLS in front of it.
# BIND_ADDRESS=127.0.0.1
# PORT=3000
# 'authenticated' = sign in to read; 'public' = anonymous visitors can read
# published content in public topics. Default: public. Admins can also change
# this at runtime in Admin -> Authentication.
# KNOWLEDGE_E3_DEFAULT_READ_ACCESS=public

# --- Behind a TLS reverse proxy (recommended for anything public) -----------
# NODE_ENV=production is what puts the Secure flag on the session cookie, so a
# plain-HTTP loopback trial must stay on the `development` default or sign-in
# cannot set its cookie. Set all three together once TLS is in front.
# NODE_ENV=production
# HTTPS_ONLY=1
# KNOWLEDGE_E3_ALLOWED_ORIGINS=https://knowledge.example.com
# Proxy hops allowed to report the client address (X-Forwarded-For). Needed for
# the per-IP sign-in throttle to see real clients; `1` for a single terminator.
# TRUST_PROXY=1

# --- Git sources ------------------------------------------------------------
# A source whose remote is a PRIVATE repository needs a credential: the container
# has none, and git then fails the sync with an authentication error.
#
# Each source carries its OWN credential, which is how two GitHub accounts, or
# GitHub plus Bitbucket, work on one instance:
#
#   1. In Admin -> Sources, open the source and set "Host token env var" to a
#      name you choose, e.g. ACME_DOCS_TOKEN. (Any mode — a `direct` or
#      `read-only` source on a private repo needs this exactly as much as a
#      `review` one.) Pick the "Host" too: it decides the username git sends
#      with the token (GitHub -> x-access-token, Bitbucket -> x-token-auth).
#   2. Add that variable HERE, below, with the token as its value.
#   3. Restart: `docker compose up -d`. Compose passes this whole file to the
#      container (`env_file`), so a new variable needs no compose edit.
#
# The token is never stored in the database, never written to gitconfig, never
# put in a remote URL or in an argument `ps` could show, and never returned by
# the API — Admin -> Sources reports only whether the named variable is set.
#
# Use HTTPS remotes: there is no SSH key in the container, so git@github.com
# URLs cannot authenticate.
#
# ACME_DOCS_TOKEN=github_pat_xxxxxxxxxxxx
# BITBUCKET_DOCS_TOKEN=xxxxxxxxxxxx
# Bitbucket Data Center instances configured for personal access tokens want a
# real account name rather than x-token-auth. Override per variable by appending
# _USERNAME to it:
# BITBUCKET_DOCS_TOKEN_USERNAME=e3.service
#
# Instance-wide FALLBACK, used by any source that names no variable of its own
# (or names one that is not set). Right for a single-host instance with one
# identity; a source's own variable always wins over it.
# GIT_HTTPS_TOKEN=github_pat_xxxxxxxxxxxx
# Identity on commits the git-of-record mirror makes.
# GIT_AUTHOR_NAME=Knowledge E3
# GIT_AUTHOR_EMAIL=knowledge-e3@users.noreply.github.com

# --- Storage ----------------------------------------------------------------
# SQLite journal mode. WAL is best on a real block/local volume; use DELETE if
# /data is a network filesystem (SMB / NFS / Azure Files), where WAL breaks.
# SQLITE_JOURNAL_MODE=WAL

# --- Optional ---------------------------------------------------------------
# Per-user MCP JSON-RPC request budget (requests/min). Default 120.
# KNOWLEDGE_E3_MCP_RATE_LIMIT=120
# Status for imported items that declare none: draft | published. Default draft.
# KNOWLEDGE_E3_IMPORT_DEFAULT_STATUS=draft
