# Copy to `.env` and fill in real values. `.env` is gitignored.
# Used by docker-compose.yml.

# SQL Server SA password (only needed if you run the optional `mssql` service).
# Must satisfy SQL Server complexity rules (8+ chars, upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=change-me-Strong!Pass123

# Per-user MCP JSON-RPC request budget (requests/min). Optional; defaults to 120.
# KNOWLEDGE_E3_MCP_RATE_LIMIT=120
