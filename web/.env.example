# Knowledge Platform — Web Client Configuration

# API base URL (defaults to /api/v1 relative to the app origin)
# VITE_API_BASE=http://localhost:3000/api/v1

# New editor (CM6 + Lexical) is enabled by default. Set to 'false' to use the legacy Tiptap editor.
# The new editor features three modes: hybrid (default), preview, and WYSIWYG.
# Omit this variable or set to anything other than 'false' to use the new editor.
# VITE_NEW_EDITOR=false  # Uncomment to rollback to legacy Tiptap editor

# No-auth local MVP mode
# When the server is started with KNOWLEDGE_E3_AUTH_MODE=disabled, set this too so
# the web shell does not redirect unauthenticated users to /login.
# VITE_KNOWLEDGE_E3_AUTH_MODE=disabled
