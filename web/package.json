{
  "name": "@echozedlabs/web",
  "version": "0.1.0-dev",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Knowledge E3 — React + Vite web client",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/clean-db.js && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e:ci": "node tests/e2e/clean-db.js && playwright test --grep-invert @quarantine"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@tanstack/react-router": "^1.47.2",
    "@tanstack/react-query": "^5.56.2",
    "@echozedlabs/codec": "workspace:*",
    "@echozedlabs/react": "^0.3.0",
    "@echozedlabs/wysiwyg-lexical": "^0.3.0",
    "yaml": "^2.4.5",
    "remark-gfm": "^4.0.0",
    "react-markdown": "^9.0.1",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "gray-matter": "^4.0.3",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "shiki": "^4.0.2",
    "mermaid": "^11.15.0",
    "lexical": "^0.44.0",
    "@lexical/code": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/table": "^0.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
