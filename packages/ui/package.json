{
  "name": "@echozedlabs/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design tokens, Tailwind preset, and shared presentational components (badges, result rows, cards) for Knowledge E3.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@echozedlabs/knowledge-types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.4",
    "typescript": "^5.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.0.1",
    "tailwindcss": "^3.4.14"
  }
}
