{
  "name": "@echozedlabs/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed REST client for the Knowledge E3 API v1, generated from the server's OpenAPI document.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "openapi-typescript ../../server/openapi.json -o src/generated/openapi.d.ts"
  },
  "dependencies": {
    "@echozedlabs/knowledge-types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.4",
    "typescript": "^5.6.3",
    "openapi-typescript": "^7.4.0"
  }
}
