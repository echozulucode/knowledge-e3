{
  "name": "@echozedlabs/mcp-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The one MCP tool contract shared by the server's HTTP MCP and the stdio knowledge-mcp app: read-tool descriptors, input normalization, the read backend interface, and error mapping.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@echozedlabs/content-model": "workspace:*",
    "@echozedlabs/knowledge-types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.4",
    "typescript": "^5.6.3"
  }
}
