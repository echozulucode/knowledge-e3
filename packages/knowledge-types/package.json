{
  "name": "@echozedlabs/knowledge-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared DTOs and interfaces (KnowledgeQuery, ContentCommands, SearchProvider, ContentStore, GitRepo, ChangeRequestHost) for Knowledge E3.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "^2.1.4",
    "typescript": "^5.6.3"
  }
}
