{
  "name": "@echozedlabs/server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --import @swc-node/register/esm-register src/db/migrate.ts",
    "seed": "node --import @swc-node/register/esm-register src/seed.ts",
    "seed:large": "node --import @swc-node/register/esm-register scripts/seed-large-library.ts",
    "populate:demo": "node --import @swc-node/register/esm-register scripts/populate-demo-corpus.ts",
    "data:generate": "node --import @swc-node/register/esm-register scripts/generate-sample-dataset.ts",
    "data:reset": "node --import @swc-node/register/esm-register scripts/reset-data.ts",
    "data:fresh": "node --import @swc-node/register/esm-register scripts/fresh-data.ts",
    "data:import": "node --import @swc-node/register/esm-register scripts/import-sample-dataset.ts",
    "data:load": "node --import @swc-node/register/esm-register scripts/import-sample-dataset.ts --reset",
    "bench": "node --import @swc-node/register/esm-register bench/run.ts",
    "perf:large": "node --import @swc-node/register/esm-register bench/run-large-library.ts",
    "export:okf": "node --import @swc-node/register/esm-register scripts/export-okf.ts",
    "import:okf": "node --import @swc-node/register/esm-register scripts/import-okf.ts",
    "rebuild:git": "node --import @swc-node/register/esm-register scripts/rebuild-from-git.ts"
  },
  "dependencies": {
    "@echozedlabs/codec": "workspace:*",
    "@echozedlabs/okf": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "kysely": "^0.27.4",
    "nanoid": "^5.0.7",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.7.0",
    "@swc/core-win32-x64-msvc": "^1.15.32",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.4"
  }
}
